# Copia este archivo a .env.local y rellena los valores (nunca subas .env.local al repo).
# Supabase → Project Settings → API
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
# Solo para código de servidor. Nunca en el cliente.
SUPABASE_SERVICE_ROLE_KEY=

# Dirección pública de la web, sin barra final (enlaces del QR y del correo).
# Si falta: en Vercel se usa la dirección de producción; en local, http://localhost:3000.
SITE_URL=

# Correo de confirmación con Resend (resend.com → API Keys).
# Hasta verificar el dominio, Resend solo envía a la dirección de la cuenta y el
# remitente debe ser "Euronest Apartamentos <onboarding@resend.dev>".
RESEND_API_KEY=
EMAIL_FROM=
